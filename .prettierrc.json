{
    "overrides": [
        {
            "files": "**/*.yml",
            "options": {
                "tabWidth": 2
            }
        },
        {
            "files": "**/*.md",
            "options": {
                "embeddedLanguageFormatting": "off",
                "printWidth": 120,
                "proseWrap": "always",
                "tabWidth": 2
            }
        },
        {
            "files": "CHANGELOG.md",
            "options": {
                "proseWrap": "preserve"
            }
        }
    ]
}
